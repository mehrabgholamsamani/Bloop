generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum RoomId {
  public
  private
}

model User {
  id        String    @id @default(uuid()) @db.Uuid
  name      String    @db.VarChar(24)
  bio       String    @default("") @db.VarChar(160)
  avatarUrl String?
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  sessions  Session[]
  messages  Message[]
  reactions Reaction[]
  pins      PinnedMessage[]
}

model Session {
  id                  String              @id @default(uuid()) @db.Uuid
  tokenHash           String              @unique
  userId              String              @db.Uuid
  expiresAt           DateTime
  createdAt           DateTime            @default(now())
  user                User                @relation(fields: [userId], references: [id], onDelete: Cascade)
  privateRoomAccesses PrivateRoomAccess[]

  @@index([expiresAt])
  @@index([userId])
}

model Message {
  id        String    @id @default(uuid()) @db.Uuid
  roomId    RoomId
  authorId  String    @db.Uuid
  text      String?   @db.VarChar(500)
  createdAt DateTime  @default(now())
  updatedAt DateTime?
  deletedAt DateTime?
  parentId   String?   @db.Uuid
  author    User      @relation(fields: [authorId], references: [id], onDelete: Restrict)
  parent    Message?  @relation("MessageReplies", fields: [parentId], references: [id], onDelete: SetNull)
  replies   Message[] @relation("MessageReplies")
  reactions Reaction[]
  pins      PinnedMessage[]

  @@index([roomId, createdAt])
  @@index([authorId])
  @@index([parentId])
}

model Reaction {
  id        String   @id @default(uuid()) @db.Uuid
  messageId String   @db.Uuid
  userId    String   @db.Uuid
  emoji     String   @db.VarChar(16)
  createdAt DateTime @default(now())
  message   Message  @relation(fields: [messageId], references: [id], onDelete: Cascade)
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([messageId, userId, emoji])
  @@index([messageId])
}

model PinnedMessage {
  id        String   @id @default(uuid()) @db.Uuid
  roomId    RoomId   @unique
  messageId String   @unique @db.Uuid
  pinnedBy  String   @db.Uuid
  createdAt DateTime @default(now())
  message   Message  @relation(fields: [messageId], references: [id], onDelete: Cascade)
  user      User     @relation(fields: [pinnedBy], references: [id], onDelete: Cascade)
}

model AppSetting {
  key       String   @id
  value     String
  updatedAt DateTime @updatedAt
}

model ModerationAction {
  id        String   @id @default(uuid()) @db.Uuid
  userId    String   @db.Uuid
  kind      String   @db.VarChar(16)
  expiresAt DateTime?
  reason    String?  @db.VarChar(300)
  createdAt DateTime @default(now())
  @@index([userId, kind, expiresAt])
}

model Report {
  id        String   @id @default(uuid()) @db.Uuid
  reporterId String  @db.Uuid
  messageId String?  @db.Uuid
  reason    String   @db.VarChar(300)
  status    String   @default("open") @db.VarChar(16)
  createdAt DateTime @default(now())
  @@index([status, createdAt])
}

model AdminAuditLog {
  id        String   @id @default(uuid()) @db.Uuid
  action    String   @db.VarChar(64)
  targetId  String?
  details   String?
  createdAt DateTime @default(now())
  @@index([createdAt])
}

model PrivateRoomAccess {
  id        String   @id @default(uuid()) @db.Uuid
  sessionId String   @db.Uuid
  expiresAt DateTime
  createdAt DateTime @default(now())
  session   Session  @relation(fields: [sessionId], references: [id], onDelete: Cascade)

  @@index([sessionId, expiresAt])
}
